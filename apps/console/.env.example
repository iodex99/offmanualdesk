# Off Manual console — copy to .env.local for development. Never commit real values.
# Production values live in Vercel project environment variables.

# Postgres (M3) — Neon/Supabase/Vercel Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/offmanual

# Envelope-encryption key for secrets at rest (TOTP secrets etc.), base64 32 bytes (M3)
OM_DATA_KEY=

# OAuth for employee and console sign-in (M3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Email (Resend) (M3)
RESEND_API_KEY=
OM_EMAIL_FROM="Off Manual <noreply@example.com>"

# Release registration from GitHub Actions (M8): shared bearer token for POST /api/releases
OM_RELEASE_REGISTER_TOKEN=
# Only Authenticode-signed releases leave ring 0 (ADR-057). Set to true only for a pilot before
# the Azure Trusted Signing account exists.
OM_ALLOW_UNSIGNED_RELEASES=false

# Billing (M9) — confirm with Off Manual's CA before going live
OFFMANUAL_GSTIN=
OFFMANUAL_STATE_CODE=27
OFFMANUAL_DEFAULT_SAC=998313
# Seller name and address printed on invoice PDFs
OFFMANUAL_LEGAL_NAME="Off Manual"
OFFMANUAL_ADDRESS="Mumbai, Maharashtra"
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> to /api/cron/billing (daily 01:00 IST); 16+ random characters
CRON_SECRET=

# Public base URL of the console (OAuth redirect URIs: <url>/auth/callback/google and /microsoft)
OM_CONSOLE_URL=http://localhost:3000

# Shown on /api/health; set by the deploy pipeline
OM_CONSOLE_VERSION=0.0.0-dev
